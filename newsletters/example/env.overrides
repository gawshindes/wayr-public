# ---- Example Digest — appended to .env.demo-example by demo.sh; later keys win ----
PIPELINE_MODE=newsletter
# Models: one provider:model per role; any provider with a key in .env.demo.base works.
MODEL_CLASSIFICATION=openai:gpt-6-luna
MODEL_CLASSIFICATION_INDUSTRY=openai:gpt-6-luna
MODEL_CLASSIFICATION_NEWS=openai:gpt-6-luna
MODEL_CLASSIFICATION_CATEGORY=openai:gpt-6-luna
MODEL_DEDUP=openai:gpt-6-luna
MODEL_IMPORTANCE=openai:gpt-6-luna
MODEL_SUMMARY=openai:gpt-6-luna
MODEL_NEWSLETTER=openai:gpt-6-luna
PLATFORM_NAME=Example Digest
INDUSTRY=Software Technology
INDUSTRY_CATEGORIES=Startup,AI,Enterprise,Mobile & Apps,Security & Privacy,General
RSS_FEEDS_FILE=newsletters/example/sources.txt
NEWSLETTER_SECTIONS_FILE=newsletters/example/sections.yaml
NEWSLETTER_IMPORTANCE_CRITERIA_FILE=newsletters/example/criteria.md
NEWSLETTER_VOICE_FILE=newsletters/example/voice.md
# Link-heavy issue: more slots, and a lower roundup bar so the Quick Links tail fills.
NEWSLETTER_MAX_STORIES=15
NEWSLETTER_MIN_STORIES=5
NEWSLETTER_ROUNDUP_THRESHOLD=0.3
NEWSLETTER_MAX_STORY_AGE_HOURS=96
# Rate-limit budget: cap what the classifiers read and keep few chains in flight.
CLASSIFICATION_MAX_CONTENT_CHARS=3000
PIPELINE_CONCURRENCY=4
NEWSLETTER_PUBLISHER=wordpress
# Drafts land on the WordPress site in .env.demo.base (WORDPRESS_URL / USERNAME / APP_PASSWORD);
# use a staging site so a test draft can never touch production.
NEWSLETTER_WORDPRESS_CATEGORY=Newsletter - Example
ARTICLE_CACHE_FILE=data/example/processed_articles.json
FEED_LEDGER_FILE=data/example/feed_ledger.json
NEWSLETTER_RUNS_FILE=data/example/newsletter_runs.json
WP_TAXONOMY_CACHE_FILE=data/example/wp_taxonomy.json
# If a Supabase mirror is configured, a region of its own keeps these rows separable and purgeable.
REGION=example
