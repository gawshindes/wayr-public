# WAYR Platform Configuration
# Copy this file to .env and fill in your actual values

# ============================================
# OpenAI Configuration (Required)
# ============================================
# Used by Author Agent and Classification Agent
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-proj-your-openai-key-here

# ============================================
# Anthropic Configuration (Required)
# ============================================
# Used by Proofreader Agent for article editing
# Get your API key from: https://console.anthropic.com
ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# ============================================
# Google AI Configuration (Optional)
# ============================================
# For Gemini models (classification, trends, etc.)
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_API_KEY=your-google-ai-key-here

# ============================================
# Model Selection Per Agent
# ============================================
# Choose which model each agent uses for optimal performance and cost
# Format: provider:model_name

# Author Agent - Writes article content
MODEL_AUTHOR=anthropic:claude-sonnet-4-6

# Classification Agent - Categorizes articles (L1: content type, L2: category)
# MODEL_CLASSIFICATION=anthropic:claude-haiku-4-5-20251001
# Per-stage overrides (fall back to MODEL_CLASSIFICATION if unset)
MODEL_CLASSIFICATION_INDUSTRY=openai:gpt-5.4-nano
MODEL_CLASSIFICATION_NEWS=openai:gpt-5.4-nano
MODEL_CLASSIFICATION_CATEGORY=anthropic:claude-haiku-4-5-20251001

# Proofreader Agent - Edits and refines articles
MODEL_PROOFREADER=anthropic:claude-haiku-4-5-20251001

# Social Media Summary Agent - Generates concise summaries for social platforms
MODEL_SUMMARY=openai:gpt-5.4-nano

# Discovery Agent - Fetches RSS feeds (no AI model needed)
# This agent uses feedparser library, not LLMs

# Deduplication Agent - Identifies duplicate stories via title similarity
MODEL_DEDUP=anthropic:claude-haiku-4-5-20251001
DEDUP_WINDOW_DAYS=7

# ============================================
# Agent Temperature & Token Settings
# ============================================
# Temperature controls randomness (0.0=deterministic, 1.0=creative)
# Max tokens controls response length

# Classification Agent - Uses low temperature for consistency
CLASSIFICATION_TEMPERATURE=0.3
CLASSIFICATION_MAX_TOKENS=2048
# Optional cap on article text sent to the classifiers (full content is kept).
# Halves tokens per run on a rate-limited tier; unset = send everything.
# CLASSIFICATION_MAX_CONTENT_CHARS=3000

# Author Agent - Uses higher temperature for creative writing
AUTHOR_TEMPERATURE=0.7
AUTHOR_MAX_TOKENS=2500

# Proofreader Agent - Uses low temperature for consistent editing
PROOFREADER_TEMPERATURE=0.3
PROOFREADER_MAX_TOKENS=2500

# ============================================
# Pipeline Mode
# ============================================
# news       → the per-story WordPress pipeline (default; existing behaviour)
# newsletter → 2-hourly prework + a daily compile pushed to Beehiiv as a draft.
#              Never builds the author, proofreader, WordPress or social agents.
# both       → news site AND newsletter from one research pass: the pipeline also
#              scores the pool; a daily Beehiiv draft is compiled from it.
#              Needs WORDPRESS_* and BEEHIIV_*.
PIPELINE_MODE=news

# ============================================
# WordPress Configuration (Required in news mode)
# ============================================
# Your WordPress site URL
WORDPRESS_URL=https://your-wordpress-site.example.com/

# WordPress username (for REST API)
WORDPRESS_USERNAME=your-wordpress-username

# WordPress Application Password (NOT your regular password!)
# Generate one at: WordPress Admin → Users → Profile → Application Passwords
WORDPRESS_APP_PASSWORD=xxxx xxxx xxxx xxxx xxxx xxxx

# ============================================
# Beehiiv Configuration (Required in newsletter mode)
# ============================================
# API key: Beehiiv → Settings → Integrations → API
# BEEHIIV_API_KEY=
# BEEHIIV_PUBLICATION_ID=pub_xxxxxxxx
# NEWSLETTER_PUBLISHER=beehiiv        # beehiiv (needs Beehiiv Max/Enterprise) | wordpress (draft post, needs WORDPRESS_*)
# NEWSLETTER_WORDPRESS_CATEGORY=Newsletter
# NEWSLETTER_WORDPRESS_TAGS=newsletter        # tags on each issue post, comma-separated
# NEWSLETTER_PUBLIC_URL_TEMPLATE=https://example.com/{slug}   # readers' URL when the site is not the CMS (email link, social post)
# NEWSLETTER_LABEL=Daily Digest                # opens the email subject, issue header and every social post
# NEWSLETTER_PUBLIC_URL_WAIT_SECONDS=300       # wait for that URL to answer 200 before sharing (0 = at once)

# Newsletter compile (newsletter mode): one call writes subject, intro, headlines, emoji
# MODEL_NEWSLETTER=google:gemini-flash-latest

# Sources list as a file (one URL per line, # comments). Replaces RSS_FEEDS when set.
# Lines: URL [type=rss|page] [origin=press|brand]  # comment   (see CLAUDE.md)
# RSS_FEEDS_FILE=newsletters/my-newsletter/sources.txt

# Importance agent (newsletter mode): scores each news story 0-1 for the readers
# MODEL_IMPORTANCE=google:gemini-flash-latest
# Who the readers are and what matters to them — the per-customer tuning seam.
# Resolution order: inline var → file → packaged default (derived from INDUSTRY).
# For anything longer than a sentence use the file. Start from the example:
#   cp wayr/templates/importance_criteria.example.md criteria.md   (then edit)
# NEWSLETTER_IMPORTANCE_CRITERIA_FILE=criteria.md
# Voice guide for the compile call: tone, opening, commentary length (default: plain house voice).
# NEWSLETTER_VOICE_FILE=newsletters/my-newsletter/voice.md
# What the publisher does with an issue: draft (default) or publish. WordPress honours publish now;
# Beehiiv creates drafts until sending is verified against a paid Max/Enterprise plan.
# NEWSLETTER_DELIVERY=draft
# Mailer: send the published issue to subscribers (publisher puts it on the web, mailer emails it).
#   none (default)
#   resend-direct — one email per confirmed row of your own `subscribers` table in Supabase, via
#                   Resend's batch endpoint; each with its own unsubscribe link. draft → the issue
#                   goes to NEWSLETTER_TEST_RECIPIENTS only; publish → the list. Sending-only key ok.
#   resend        — one Resend Broadcast to a Segment (list at Resend; full-access key; draft stays
#                   in the Resend dashboard).
# NEWSLETTER_MAILER=none
# RESEND_API_KEY=re_xxxxxxxx
# NEWSLETTER_FROM=My Newsletter <daily@example.com>     # domain must be verified at Resend
# NEWSLETTER_REPLY_TO=hello@example.com
# NEWSLETTER_UNSUBSCRIBE_URL=https://example.com/newsletter/unsubscribe?token={token}   # resend-direct
# NEWSLETTER_TEST_RECIPIENTS=you@example.com                                           # resend-direct
# RESEND_SEGMENT_ID=                                                                   # resend
# NEWSLETTER_IMPORTANCE_CRITERIA="One-line override, mainly for tests"

# ============================================
# RSS Feed Sources
# ============================================
# Comma-separated list of RSS feed URLs to monitor
RSS_FEEDS=https://techcrunch.com/feed/,https://www.theverge.com/rss/index.xml,https://www.wired.com/feed/category/business/latest/rss,https://www.wired.com/feed/tag/ai/latest/rss,https://venturebeat.com/feed/

# ============================================
# Industry / Category Configuration
# ============================================
# Target industry scope — drives the industry classifier. Required.
INDUSTRY=Software Technology

# Allowed news categories for the category classifier (comma-separated). Required.
# Primary + secondary are chosen from this list.
INDUSTRY_CATEGORIES=Startup,AI,Enterprise,Mobile & Apps,Gaming,Security & Privacy,General

# Region tag written to pipeline_articles.region at discovery time.
# Use 'us' or 'india' in prod Modal secrets; 'staging' for local runs.
REGION=staging

# ============================================
# Agent Configuration
# ============================================
# How often to fetch new articles (in minutes)
FETCH_INTERVAL_MINUTES=30

# Maximum articles to process per run
MAX_ARTICLES_PROCESSED_PER_RUN=50
MAX_ARTICLES_PUBLISHED_PER_RUN=5

# Minimum word count of extracted article content required for an article to
# enter the processing pipeline. Articles below this threshold are dropped at
# discovery — we don't classify or generate off title-only input.
MIN_CONTENT_WORDS=50

# Enable proofreading with Claude (true/false)
# Set to false to skip the proofreading step and save costs
ENABLE_PROOFREADING=false

# ============================================
# Pipeline Stage Toggles
# ============================================
# Switch individual pipeline steps on/off (true/false, all default to true).
# ENABLE_DISCOVERY=false       → skip RSS discovery; only cached candidates from previous runs are processed
# ENABLE_CLASSIFICATION=false  → skip classifiers; all discovered articles are treated as news
# ENABLE_AUTHOR=false          → skip article generation; pipeline stops after classification
# ENABLE_SUMMARY=false         → skip summary generation; WordPress excerpt falls back to content extraction
# ENABLE_PUBLISHING=false      → skip WordPress publishing (behaves like preview mode)
# ENABLE_SOCIAL_POSTING=false  → skip Twitter/LinkedIn posting even if credentials are set
ENABLE_DISCOVERY=true
ENABLE_CLASSIFICATION=true
ENABLE_AUTHOR=true
ENABLE_SUMMARY=true
ENABLE_PUBLISHING=true
ENABLE_SOCIAL_POSTING=true

# ============================================
# Feed Ledger & Discovery Bounds
# ============================================
# Every feed item ever seen + per-feed ETag/Last-Modified for conditional GET.
# Prework's delta ("not yet admitted") and coverage measurement come from here.
# FEED_LEDGER_FILE=data/feed_ledger.json
# FEED_LEDGER_RETENTION_DAYS=90       # keyed on last-seen, so slow feeds are never re-admitted
# DISCOVERY_BOOTSTRAP_MAX=300         # per-run ceiling when uncapped (newsletter mode)

# ============================================
# Content Generation Settings
# ============================================
# Target word count for generated articles
ARTICLE_TARGET_WORDS=700

# ============================================
# Platform Settings
# ============================================
PLATFORM_NAME=WAYR

# Disclosure notice added to all AI-generated content
AI_DISCLOSURE_NOTICE=This article was generated by AI and cites original sources.

# ============================================
# Logging
# ============================================
# Options: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# ============================================
# Cache File Paths (for Modal deployment)
# ============================================
# Use absolute paths (/data/) for Modal volume persistence. On Modal the deploy
# injects /data/ defaults for all state files (this one, WP_TAXONOMY_CACHE_FILE,
# FEED_LEDGER_FILE, NEWSLETTER_RUNS_FILE); values in the secret override them.
# Local development will use relative paths (data/) as fallback
ARTICLE_CACHE_FILE=data/processed_articles.json
WP_TAXONOMY_CACHE_FILE=data/wp_taxonomy.json

# ============================================
# Twitter/X API Configuration (Optional)
# ============================================
# Twitter API v2 credentials (OAuth 1.0a)
# Get from: https://developer.twitter.com/en/portal/dashboard
TWITTER_API_KEY=
TWITTER_API_SECRET=
TWITTER_ACCESS_TOKEN=
TWITTER_ACCESS_TOKEN_SECRET=

# ============================================
# LinkedIn Community Management API Configuration (Optional)
# ============================================
# For posting to LinkedIn Company Page via Community Management API
# API docs: https://learn.microsoft.com/en-us/linkedin/marketing/community-management/shares/posts-api
# Get credentials: Run python scripts/get_linkedin_token.py
LINKEDIN_ORGANIZATION_URN=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
LINKEDIN_ACCESS_TOKEN=

# ============================================
# Supabase (Required — pipeline persistence + eval labels)
# ============================================
# Project URL and service-role key from your Supabase project settings
SUPABASE_URL=https://your-project-id.supabase.co/
SUPABASE_SECRET_KEY=your-supabase-service-role-key
