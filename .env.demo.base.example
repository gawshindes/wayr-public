# .env.demo.base — secrets and shared settings for every demo. Copy to .env.demo.base (gitignored).
# demo.sh appends newsletters/<name>/env.overrides to this file; later keys win.

# LLM providers (every demo runs on OpenAI GPT-6 Luna by default)
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# Where drafts land: a WordPress site and an application password (staging, never production)
WORDPRESS_URL=https://staging.example.com
WORDPRESS_USERNAME=
WORDPRESS_APP_PASSWORD=

# Optional mirror of pipeline data (each demo tags its rows with its own REGION)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Beehiiv, only if a demo sets NEWSLETTER_PUBLISHER=beehiiv (post creation needs a paid Max/Enterprise plan)
BEEHIIV_API_KEY=
BEEHIIV_PUBLICATION_ID=

# Resend, only if a newsletter sets NEWSLETTER_MAILER=resend (no demo does; production wayrtoday can)
RESEND_API_KEY=

# Shared defaults
LOG_LEVEL=INFO
MIN_CONTENT_WORDS=50
DEDUP_WINDOW_DAYS=7
CLASSIFICATION_MAX_CONTENT_CHARS=3000
PIPELINE_CONCURRENCY=4
AI_DISCLOSURE_NOTICE=This article was generated by AI and cites original sources.
RSS_FEEDS=https://techcrunch.com/feed/   # placeholder; every demo sets RSS_FEEDS_FILE or imports a pool
